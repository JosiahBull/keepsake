DATABASE_URL=sqlite:data/keepsake.db
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info

# Set this for a production build. Startup checks that index.html is readable.
# WEB_DIR=packages/web/dist

# Default lists to add to Josiah's and Ansam's libraries; unset adds none.
# Startup checks every list. `pnpm dev` uses default-lists from the checkout.
# DEFAULT_LISTS_DIR=default-lists

SHUTDOWN_GRACE_SECS=10
HEADER_READ_TIMEOUT_SECS=15
CONNECTION_TIMEOUT_SECS=120
REQUEST_TIMEOUT_SECS=30
MAX_CONNECTIONS=128
MAX_IN_FLIGHT=32
MAX_BODY_BYTES=524288

# Push services may contact this address about reminder traffic. Use mailto: or https:.
# PUSH_CONTACT=https://github.com/JosiahBull/keepsake

# Agent access over MCP: the most any profile may choose (off, read or write). Unset is off,
# and /mcp is not mounted. Each profile then chooses its own access in Profile settings.
# KEEPSAKE_MCP=read
# Host names agents may use besides loopback, comma separated.
# KEEPSAKE_MCP_ALLOWED_HOSTS=keepsake.example.com
