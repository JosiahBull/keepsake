DATABASE_URL=sqlite:data/keepsake.db
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info

# Set this for a production build. Startup checks that index.html is readable.
# WEB_DIR=packages/web/dist

SHUTDOWN_GRACE_SECS=10
HEADER_READ_TIMEOUT_SECS=15
CONNECTION_TIMEOUT_SECS=120
REQUEST_TIMEOUT_SECS=30
MAX_CONNECTIONS=128
MAX_IN_FLIGHT=32
MAX_BODY_BYTES=524288
